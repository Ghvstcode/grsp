{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "grsp",
    "version": "0.1.2",
    "identifier": "app.grsp.desktop",
    "build": {
        "beforeDevCommand": "pnpm vite:dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "grsp",
                "label": "main",
                "url": "/",
                "width": 1440,
                "height": 900,
                "decorations": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
        "createUpdaterArtifacts": true,
        "macOS": {
            "entitlements": "macos.entitlements",
            "dmg": {
                "appPosition": { "x": 180, "y": 170 },
                "applicationFolderPosition": { "x": 480, "y": 170 },
                "windowSize": { "width": 660, "height": 400 }
            }
        }
    },
    "plugins": {
        "shell": {
            "open": "."
        },
        "sql": {
            "preload": ["sqlite:grsp.db"]
        },
        "deep-link": {
            "desktop": {
                "schemes": ["grsp"]
            }
        },
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQ0Y2QzBCQzJGRTI2RDAKUldUUUp2N0NDMnpQTTNTSDVBWHNIWkI0TDZ4dVJiVUc5WjBNNGZQTSt6QzBnUlVVaFREVEdvN0YK",
            "endpoints": [
                "https://github.com/ghvstcode/grsp/releases/latest/download/latest.json"
            ]
        }
    }
}
